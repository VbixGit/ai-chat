# .env.example
# คัดลอกไฟล์นี้เป็น `.env` แล้วเติมค่าจริง (ห้าม commit คีย์ลับลง repo)
# คำอธิบายตัวแปรด้านล่างอ้างอิงจากการใช้งานใน `src/App.js`

# Weaviate (Vector DB) endpoint
# ตัวอย่าง: https://your-weaviate-instance.example.com
REACT_APP_WEAVIATE_ENDPOINT=gpdghz3tj28dvss2b9fg.c0.asia-southeast1.gcp.weaviate.cloud

# Weaviate API key (ใช้สำหรับ Authorization header)
REACT_APP_WEAVIATE_API_KEY=

# OpenAI API key (ใช้สำหรับการสร้าง embedding และเรียก LLM)
REACT_APP_OPENAI_API_KEY=

# Optional: Backend API base URL / proxy (ถ้ามี)
# ถ้าคุณเรียก API ผ่าน backend โปรดตั้งค่านี้ เช่น: https://api.your-domain.com
REACT_APP_API_BASE=

# Context token limit used by the app (ตัวเลขจำนวนโทเค็นที่ต้องการเป็นค่าเริ่มต้น)
# ค่าเริ่มต้นที่โค้ดใช้ถ้าไม่ได้ตั้งค่า: 8192
REACT_APP_OPENAI_CONTEXT_LIMIT=8192

# ----- หมายเหตุเพิ่มเติม -----
# - เก็บไฟล์ `.env` ไว้ในเครื่อง local เท่านั้น และอย่า push ค่าจริงไปยัง remote repository.
# - ถ้าจะรันใน environment ของเซิร์ฟเวอร์/hosting ให้ตั้งค่าตามระบบนั้นๆ (เช่น Azure App Settings, Vercel Environment Variables ฯลฯ)